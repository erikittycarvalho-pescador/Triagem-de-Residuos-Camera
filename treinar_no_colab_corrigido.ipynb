    "Se quiser mesclar o TACO, ajuste USE_TACO = True e rode as células.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "USE_TACO = False  #@param {type:\"boolean\"}\n",
    "if USE_TACO:\n",
