   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6) Converter para TensorFlow.js (robusto)\n",
    "Este fluxo NÃO reinstala o TensorFlow nem reinicia o runtime. Ele instala apenas o pacote `tensorflowjs` e usa o conversor de linha de comando, o que evita conflitos binários.\n",
    "Observação: se você anteriormente instalou uma versão diferente do TensorFlow no mesmo runtime e o kernel está instável, reinicie o runtime manualmente (Runtime → Restart runtime) antes de executar esta célula.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6 - Converter para TensorFlow.js (robusto)\n",
    "# Instala apenas tensorflowjs e usa o conversor CLI; tenta salvar como .h5 e cai para SavedModel se necessário.\n",
    "import os, subprocess, shlex\n",
    "print('Instalando tensorflowjs...')\n",
    "subprocess.check_call(["/usr/bin/python3", "-m", "pip", "install", "-q", "tensorflowjs"])\n",
    "import tensorflow as tf\n",
    "from tensorflow import keras\n",
    "\n",
    "MODEL_KERAS_PATH = '/content/modelo_residuos_mobilenetv2.keras'\n",
    "OUT_TFJS_DIR = '/content/modelo_tfjs'\n",
    "H5_PATH = '/content/modelo_residuos_mobilenetv2.h5'\n",
    "SAVED_MODEL_DIR = '/content/model_saved'\n",
    "\n",
    "if not os.path.exists(MODEL_KERAS_PATH):\n",
    "    raise FileNotFoundError(f'Modelo não encontrado em {MODEL_KERAS_PATH}. Certifique-se de que o treino salvou o modelo neste caminho.')\n",
    "\n",
    "print('Carregando modelo Keras do disco (pode demorar)...')\n",
    "model = keras.models.load_model(MODEL_KERAS_PATH)\n",
    "print('Modelo carregado. Tentando salvar em HDF5 (.h5) para conversão layers-model...')\n",
    "h5_saved = False\n",
    "try:\n",
    "    # tenta salvar como .h5 (requere que o modelo seja serializável em HDF5)
",
    "    if os.path.exists(H5_PATH):\n",
    "        os.remove(H5_PATH)\n",
    "    model.save(H5_PATH, include_optimizer=False)\n",
    "    h5_saved = True\n",
    "    print('HDF5 salvo em', H5_PATH)\n",
    "except Exception as e:\n",
    "    print('Falha ao salvar como HDF5 (normal para modelos Keras v3). Mensagem:', e)\n",
    "    print('Iremos salvar como SavedModel e usar o conversor para graph model.')\n",
    "    if os.path.exists(SAVED_MODEL_DIR):\n",
    "        import shutil\n",
    "        shutil.rmtree(SAVED_MODEL_DIR)\n",
    "    model.save(SAVED_MODEL_DIR, save_format='tf')\n",
    "    print('SavedModel gravado em', SAVED_MODEL_DIR)\n",
    "\n",
    "# remove saída antiga\n",
    "if os.path.exists(OUT_TFJS_DIR):\n",
    "    import shutil\n",
    "    shutil.rmtree(OUT_TFJS_DIR)\n",
    "\n",
    "if h5_saved:\n",
    "    # converter de HDF5 para tfjs_layers_model\n",
    "    cmd = f'tensorflowjs_converter --input_format=keras "{H5_PATH}" "{OUT_TFJS_DIR}" --output_format=tfjs_layers_model'\n",
    "else:\n",
    "    # converter SavedModel -> tfjs_graph_model\n",
    "    cmd = f'tensorflowjs_converter --input_format=tf_saved_model --output_format=tfjs_graph_model --signature_name=serving_default "{SAVED_MODEL_DIR}" "{OUT_TFJS_DIR}"'\n",
    "\n",
    "print('Executando conversor TFJS:')\n",
    "print(cmd)\n",
    "try:\n",
    "    subprocess.check_call(shlex.split(cmd))\n",
    "    print('Conversão concluída. Saída em', OUT_TFJS_DIR)\n",
    "    print('Arquivos (amostra):')\n",
    "    print(os.listdir(OUT_TFJS_DIR)[:30])\n",
    "except subprocess.CalledProcessError as e:\n",
    "    print('Erro ao executar tensorflowjs_converter:', e)\n",
    "    raise\n"
   ]
  },
  {
   "cell_type": "markdown",
