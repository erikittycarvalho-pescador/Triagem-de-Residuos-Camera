   "source": [
    "## 2) Enviar/Extrair o dataset (faça upload do ZIP do seu dataset)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "from google.colab import files\n",
    "import zipfile, os\n",
    "\n",
    "print('Selecione o ZIP do dataset (p.ex. project_triagem_residuos.zip)')\n",
    "uploaded = files.upload()\n",
    "zip_name = list(uploaded.keys())[0]\n",
    "print('Recebido:', zip_name)\n",
    "with zipfile.ZipFile(zip_name, 'r') as z:\n",
    "    z.extractall('/content/upload_extracted')\n",
    "print('Extraido em /content/upload_extracted')\n",
    "!find /content/upload_extracted -maxdepth 4 -type d | sed -e 's/^/DIR: /'"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Localiza a pasta que contém as 6 classes esperadas (cardboard, glass, metal, paper, plastic, trash)\n",
    "import os\n",
    "CLASSES = [\"cardboard\", \"glass\", \"metal\", \"paper\", \"plastic\", \"trash\"]\n",
    "candidate = None\n",
    "for root, dirs, files in os.walk('/content/upload_extracted'):\n",
    "    if all(c in dirs for c in CLASSES):\n",
    "        candidate = root\n",
    "        break\n",
    "if candidate is None:\n",
    "    print('AVISO: não encontrei automaticamente a pasta com as 6 classes. Verifique a estrutura do ZIP em /content/upload_extracted')\n",
    "else:\n",
    "    DATASET_DIR = candidate\n",
    "    print('Dataset encontrado em:', DATASET_DIR)\n",
    "    for c in CLASSES:\n",
    "        n = len(os.listdir(os.path.join(DATASET_DIR, c)))\n",
    "        print(f'  {c}: {n} imagens')\n"
   ],
