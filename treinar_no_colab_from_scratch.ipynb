   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6) Converter para TensorFlow.js — abordagem limpa (NÃO altera TF no runtime)\n",
    "Esta célula: instala apenas `tensorflowjs`, salva o modelo como .h5 se possível (mais simples) ou como SavedModel e usa `tensorflowjs_converter` via subprocess para evitar conflitos de import.\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Conversão robusta para TF.js (cole/rode esta célula APÓS treinar e salvar o modelo)\n",
    "import os, subprocess, shlex, sys, shutil\n",
    "from pathlib import Path\n",
    "MODEL_KERAS_PATH = '/content/modelo_residuos_mobilenetv2.keras'\n",
    "H5_PATH = '/content/modelo_residuos_mobilenetv2.h5'\n",
    "SAVED_MODEL_DIR = '/content/model_saved'\n",
    "OUT_TFJS_DIR = '/content/modelo_tfjs'\n",
    "\n",
    "# 1) garante tensorflowjs instalado (não troca a versão do tensorflow)\n",
    "print('Instalando tensorflowjs (se necessário)...')\n",
    "subprocess.check_call([sys.executable, '-m', 'pip', 'install', '-q', 'tensorflowjs'])\n",
    "\n",
    "# 2) garante que o modelo existe em disco\n",
    "if not os.path.exists(MODEL_KERAS_PATH):\n",
    "    raise FileNotFoundError(f'Modelo não encontrado em {MODEL_KERAS_PATH}. Rode o treino antes de converter.')\n",
    "\n",
    "# 3) carrega o modelo e tenta salvar HDF5\n",
    "import tensorflow as tf\n",
    "from tensorflow import keras\n",
    "print('Carregando modelo Keras do disco...')\n",
    "model = keras.models.load_model(MODEL_KERAS_PATH)\n",
    "h5_saved = False\n",
    "try:\n",
    "    if os.path.exists(H5_PATH):\n",
    "        os.remove(H5_PATH)\n",
    "    model.save(H5_PATH, include_optimizer=False)\n",
    "    h5_saved = True\n",
    "    print('Salvo HDF5 em', H5_PATH)\n",
    "except Exception as e:\n",
    "    print('Não foi possível salvar HDF5 (normal para alguns modelos). Motivo:', e)\n",
    "    if os.path.exists(SAVED_MODEL_DIR):\n",
    "        shutil.rmtree(SAVED_MODEL_DIR)\n",
    "    model.save(SAVED_MODEL_DIR, save_format='tf')\n",
    "    print('SavedModel gravado em', SAVED_MODEL_DIR)\n",
    "\n",
    "# 4) remove saída antiga e prepara comando\n",
    "if os.path.exists(OUT_TFJS_DIR):\n",
    "    shutil.rmtree(OUT_TFJS_DIR)\n",
    "if h5_saved:\n",
    "    cmd = f'{sys.executable} -m tensorflowjs_converter --input_format=keras "{H5_PATH}" "{OUT_TFJS_DIR}" --output_format=tfjs_layers_model'\n",
    "else:\n",
    "    cmd = f'{sys.executable} -m tensorflowjs_converter --input_format=tf_saved_model --output_format=tfjs_graph_model --signature_name=serving_default "{SAVED_MODEL_DIR}" "{OUT_TFJS_DIR}"'\n",
    "\n",
    "print('Executando:', cmd)\n",
    "try:\n",
    "    subprocess.check_call(shlex.split(cmd))\n",
    "    print('Conversão concluída. Saída em', OUT_TFJS_DIR)\n",
    "    print('Conteúdo (amostra):', os.listdir(OUT_TFJS_DIR)[:50])\n",
    "except subprocess.CalledProcessError as e:\n",
    "    print('Erro ao executar tensorflowjs_converter:', e)\n",
    "    # fallback: grava um script para conversão local (para rodar na sua máquina)\n",
    "    local_sh = '/content/convert_tfjs_local.sh'\n",
    "    with open(local_sh, 'w') as f:\n",
    "        f.write('#!/bin/bash\n')\n",
    "        if h5_saved:\n",
    "            f.write(f'python -m pip install tensorflowjs\\n')\n",
    "            f.write(f'python -m tensorflowjs_converter --input_format=keras "{H5_PATH}" "{OUT_TFJS_DIR}" --output_format=tfjs_layers_model\\n')\n",
    "        else:\n",
    "            f.write(f'python -m pip install tensorflowjs\\n')\n",
    "            f.write(f'python -m tensorflowjs_converter --input_format=tf_saved_model --output_format=tfjs_graph_model --signature_name=serving_default "{SAVED_MODEL_DIR}" "{OUT_TFJS_DIR}"\\n')\n",
    "    os.chmod(local_sh, 0o755)\n",
    "    print('Foi gerado um script de fallback para conversão local em', local_sh)\n",
    "    print('Você pode baixar o modelo (.h5 ou SavedModel) e rodar esse script na sua máquina ou em um container com TF compatível.')\n",
    "    raise\n"
   ],
   "execution_count": null,
   "outputs": []
  },
